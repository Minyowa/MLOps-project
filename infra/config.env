# infra/*.sh 공통 설정 — 필요하면 값만 바꾸세요
# 일본 사용자 대상이라 도쿄 리전 기본. AWS Academy Learner Lab은 us-east-1만 허용되는 경우가 많으니 그때는 바꾸세요.
REGION=${REGION:-ap-northeast-1}
NAME=${NAME:-linkguard}
INSTANCE_TYPE=${INSTANCE_TYPE:-t3.small}
KEY_NAME=${KEY_NAME:-linkguard-key}
KEY_FILE=${KEY_FILE:-$HOME/.ssh/linkguard-key.pem}
# CloudWatch·S3 권한이 있는 인스턴스 프로필 (Learner Lab은 LabInstanceProfile). 없으면 비워 두세요.
INSTANCE_PROFILE=${INSTANCE_PROFILE:-LabInstanceProfile}
REPO_URL=${REPO_URL:-https://github.com/Minyowa/MLOps-project.git}
APP_DIR=${APP_DIR:-/opt/linkguard}
