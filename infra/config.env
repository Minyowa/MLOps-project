# infra/*.sh 공통 설정 — 필요하면 값만 바꾸세요
# 일본 사용자 대상이라 도쿄 리전 기본. AWS Academy Learner Lab은 us-east-1만 허용되는 경우가 많으니 그때는 바꾸세요.
# CloudShell은 AWS_REGION(콘솔에서 고른 리전)을 자동으로 넣어 주므로 그 값을 먼저 씀
REGION=${REGION:-${AWS_REGION:-ap-northeast-1}}
NAME=${NAME:-linkguard}
INSTANCE_TYPE=${INSTANCE_TYPE:-t3.small}
KEY_NAME=${KEY_NAME:-linkguard-key}
KEY_FILE=${KEY_FILE:-$HOME/.ssh/linkguard-key.pem}
# CloudWatch·S3 권한이 있는 인스턴스 프로필 (Learner Lab은 LabInstanceProfile). 없으면 비워 두세요.
INSTANCE_PROFILE=${INSTANCE_PROFILE:-LabInstanceProfile}
REPO_URL=${REPO_URL:-https://github.com/Minyowa/MLOps-project.git}
APP_DIR=${APP_DIR:-/opt/linkguard}
# SSH(22) 허용 범위. GitHub Actions 러너 IP가 고정이 아니라서 기본은 전체 허용 + 키 인증만 사용
SSH_CIDR=${SSH_CIDR:-0.0.0.0/0}
# infra/up.sh가 GitHub 설정·재배포에 쓰는 값
GH_REPO=${GH_REPO:-Minyowa/MLOps-project}
DEPLOY_BRANCH=${DEPLOY_BRANCH:-feature/deploy-japan}
LOG_SINKS=${LOG_SINKS:-local}
# 1이면 고정 IP(Elastic IP)를 붙여 EC2를 다시 만들어도 주소가 같게 유지 (이름표 linkguard-eip로 찾음)
USE_EIP=${USE_EIP:-1}
